{
  "name": "hydro",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "emoji": "node scripts/gen-emoji.mjs",
    "build": "node scripts/gen-emoji.mjs && tsc --noEmit -p . && vite build && node scripts/to-artifact.mjs",
    "build:local": "node scripts/gen-emoji.mjs --inline && tsc --noEmit -p . && VITE_TARGET=local vite build --outDir dist-local && node scripts/gen-emoji.mjs",
    "test": "vitest run",
    "preview:build": "node scripts/gen-emoji.mjs --inline && vite build --outDir dist-preview && node scripts/gen-emoji.mjs"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "lucide-react": "^1.59.0",
    "motion": "^14.3.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/figtree": "^5.3.0",
    "@fontsource/geologica": "^5.3.0",
    "@lobehub/fluent-emoji-3d": "^1.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "ical.js": "2.2.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  }
}
